<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Personal Profile - Rishav Raj</title>

    <!-- ── FONTS: Google Fonts (loaded via CSS @import) ── -->

    <style>
        /* ═══════════════════════════════════════════════════
           CSS DESIGNED WITH AI ASSISTANCE (Claude by Anthropic)
           HTML structure written by Rishav Raj independently.
           AI was used only for visual styling (colors, layout,
           animations, typography, hover effects).
           ═══════════════════════════════════════════════════ */

        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@300;400;500;700&display=swap');

        /* ── CSS VARIABLES (color palette & reusables) ── */
        :root {
            --bg: #deeef7;           /* light blue background     */
            --surface: #cce3f0;      /* slightly darker blue       */
            --card: #ffffff;         /* white cards                */
            --accent: #e8799a;       /* cherry blossom pink        */
            --accent-dark: #c94d72;  /* deeper pink for text/links */
            --text: #183042;         /* dark navy for readability  */
            --text-soft: #4f6777;    /* softer body text           */
            --muted: #6f8796;        /* footer/muted text          */
            --border: #b3d3e6;       /* light blue borders         */
            --shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
        }

        /* ── RESET ── */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        /* ── BASE BODY ── */
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'DM Sans', sans-serif;
            font-weight: 400;
            line-height: 1.7;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ══════════════════════════════
           HEADER — profile photo + name
           ══════════════════════════════ */
        header {
            position: relative;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 90px 20px 70px;
            overflow: hidden;
        }

        /* soft pink glow behind photo (decorative) */
        header::before {
            content: '';
            position: absolute;
            width: 420px;
            height: 420px;
            top: -120px;
            left: 50%;
            transform: translateX(-50%);
            background: radial-gradient(
                circle,
                rgba(232, 121, 154, 0.18) 0%,
                transparent 70%
            );
            pointer-events: none;
        }

        /* profile picture */
        header img {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid var(--accent);
            box-shadow:
                0 0 0 8px rgba(232, 121, 154, 0.12),
                0 10px 25px rgba(0, 0, 0, 0.08);
            margin-bottom: 24px;
            transition: transform 0.3s ease;
        }

        header img:hover {
            transform: scale(1.03);
        }

        header h1 {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.4rem, 5vw, 3.5rem);
            font-weight: 700;
            letter-spacing: -1px;
            color: var(--text);
            margin-bottom: 10px;
        }

        header p {
            color: var(--accent-dark);
            font-size: 0.95rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* ── HORIZONTAL RULE DIVIDERS ── */
        hr {
            border: none;
            border-top: 1px solid var(--border);
        }

        /* ══════════════════════════════
           MAIN CONTENT WRAPPER
           ══════════════════════════════ */
        main {
            max-width: 820px;
            margin: auto;
            padding: 30px 22px;
        }

        /* ── SECTION BASE STYLES ── */
        section {
            padding: 50px 0;
        }

        /* section heading with animated underline on hover */
        section h2 {
            position: relative;
            display: inline-block;
            font-family: 'Playfair Display', serif;
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 22px;
        }

        section h2::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: -7px;
            width: 100%;
            height: 3px;
            background: var(--accent);
            transform: scaleX(0.35);
            transform-origin: left;
            transition: transform 0.3s ease;
        }

        /* underline expands on section hover */
        section:hover h2::after {
            transform: scaleX(1);
        }

        section p {
            color: var(--text-soft);
            font-size: 1.03rem;
            line-height: 1.9;
            max-width: 720px;
        }

        /* ══════════════════════════════
           HOBBIES — pill tag list
           ══════════════════════════════ */
        section ul {
            list-style: none;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 10px;
        }

        section ul li {
            background: var(--card);
            border: 1px solid var(--border);
            color: var(--text);
            padding: 10px 18px;
            border-radius: 999px;
            font-size: 0.9rem;
            font-weight: 500;
            box-shadow: var(--shadow);
            transition: all 0.25s ease;
        }

        section ul li:hover {
            transform: translateY(-3px);
            border-color: var(--accent);
            color: var(--accent-dark);
            box-shadow: 0 12px 25px rgba(232, 121, 154, 0.16);
        }

        /* ══════════════════════════════
           CONNECT LINKS — button style
           ══════════════════════════════ */
        .connect-links {
            display: flex;
            flex-wrap: wrap;
            gap: 16px;
        }

        /* reset inherited ul li styles for link buttons */
        .connect-links li {
            background: none !important;
            border: none !important;
            padding: 0 !important;
            box-shadow: none !important;
        }

        .connect-links a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 140px;
            padding: 12px 22px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 10px;
            text-decoration: none;
            color: var(--text);
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.25s ease;
            box-shadow: var(--shadow);
        }

        .connect-links a:hover {
            background: var(--accent);
            border-color: var(--accent);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 14px 30px rgba(232, 121, 154, 0.28);
        }

        /* ── CONTACT EMAIL LINK ── */
        section p a {
            color: var(--accent-dark);
            font-weight: 600;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        section p a:hover {
            opacity: 0.75;
            text-decoration: underline;
        }

        /* ══════════════════════════════
           FOOTER
           ══════════════════════════════ */
        footer {
            text-align: center;
            padding: 32px 20px;
            background: var(--surface);
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 0.85rem;
            letter-spacing: 0.5px;
        }

        /* ══════════════════════════════
           RESPONSIVE — mobile screens
           ══════════════════════════════ */
        @media (max-width: 600px) {
            header          { padding: 70px 20px 50px; }
            header img      { width: 120px; height: 120px; }
            section         { padding: 38px 0; }
            section h2      { font-size: 1.45rem; }
            section p       { font-size: 0.98rem; }
            .connect-links  { flex-direction: column; }
            .connect-links a { width: 100%; }
        }

    </style>
</head>

